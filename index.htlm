<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>ATELIER 3D — Catalogue</title>
<style>
:root{--bg:#070d18;--panel:#0d1728;--panel2:#101e33;--line:#1d3453;--blue:#36a9ff;--cyan:#68d7ff;--white:#f4f8ff;--muted:#91a6c1;--green:#73e0b0;--gold:#f2c879}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--white);font:15px/1.5 Inter,ui-sans-serif,system-ui,-apple-system,Segoe UI,sans-serif}
body:before{content:"";position:fixed;inset:0;pointer-events:none;background:radial-gradient(ellipse at 75% -10%,#12345b66,transparent 42%),radial-gradient(ellipse at 0% 40%,#0b2d4b44,transparent 34%);z-index:-1}
button,input,select{font:inherit}button{cursor:pointer}
.top{height:70px;border-bottom:1px solid #172942;background:#081222eF;display:flex;align-items:center;justify-content:space-between;padding:0 clamp(18px,5vw,70px);position:sticky;top:0;z-index:5;backdrop-filter:blur(16px)}
.brand{display:flex;align-items:center;gap:12px;font-weight:850;letter-spacing:.13em;font-size:13px}.brandmark{width:34px;height:34px;border-radius:11px;background:linear-gradient(145deg,#53c7ff,#1766c6);display:grid;place-items:center;box-shadow:0 0 25px #168cff55}.brandmark svg{width:22px}
.topright{display:flex;align-items:center;gap:12px}.status{font-size:11px;color:var(--green);letter-spacing:.12em;text-transform:uppercase}.admin{background:#102541;border:1px solid #28517d;color:#d9eeff;border-radius:9px;padding:9px 13px;font-size:12px}
.wrap{max-width:1280px;margin:auto;padding:0 28px}.hero{padding:65px 0 38px;display:grid;grid-template-columns:1.2fr .8fr;gap:35px;align-items:center}.kicker{color:var(--cyan);font-size:11px;font-weight:800;letter-spacing:.22em;text-transform:uppercase}.hero h1{font-size:clamp(38px,6vw,68px);line-height:.98;letter-spacing:-.055em;margin:15px 0 18px;max-width:680px}.hero h1 span{color:var(--blue)}.hero p{color:var(--muted);max-width:570px;font-size:16px}.hero-actions{display:flex;gap:11px;margin-top:25px;flex-wrap:wrap}.primary,.secondary{padding:12px 17px;border-radius:10px;font-weight:750;text-decoration:none;font-size:13px}.primary{background:linear-gradient(100deg,#43b9ff,#287ee8);color:#06101e;border:0;box-shadow:0 8px 30px #147bd633}.secondary{border:1px solid #2a4567;color:#d9eaff;background:#0d192a}
.hero-art{height:285px;border:1px solid #1b385b;border-radius:22px;position:relative;overflow:hidden;background:radial-gradient(ellipse at 55% 48%,#15538a88,transparent 42%),linear-gradient(135deg,#102744,#091321 70%);display:grid;place-items:center}.hero-art:before,.hero-art:after{content:"";position:absolute;border:1px solid #2c83c344;border-radius:50%;width:260px;height:260px;transform:rotateX(68deg)}.hero-art:after{width:350px;height:350px}.dragon{font-size:125px;filter:drop-shadow(0 10px 24px #35aaff88);transform:rotate(-12deg);z-index:1}.artlabel{position:absolute;bottom:17px;left:20px;color:#8baaca;font-size:10px;letter-spacing:.18em;text-transform:uppercase}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:10px 0 35px}.stat{border:1px solid #1b304c;background:#0c1727aa;padding:15px 17px;border-radius:13px}.stat strong{font-size:22px;display:block}.stat span{font-size:11px;color:var(--muted);letter-spacing:.08em;text-transform:uppercase}
.sectionhead{display:flex;align-items:end;justify-content:space-between;gap:15px;margin:25px 0 17px}.sectionhead h2{font-size:24px;letter-spacing:-.03em;margin:0}.sectionhead p{color:var(--muted);font-size:12px;margin:5px 0 0}.tools{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:17px}.search{flex:1;min-width:220px;background:#0d192a;border:1px solid #223c5d;color:white;border-radius:10px;padding:12px 14px;outline:none}.search:focus{border-color:var(--blue);box-shadow:0 0 0 3px #36a9ff20}.sort{background:#0d192a;color:#d7eaff;border:1px solid #223c5d;border-radius:10px;padding:0 12px}.filters{display:flex;gap:8px;flex-wrap:wrap;margin:0 0 22px}.filter{border:1px solid #203955;color:#a9bfd9;background:#0b1727;padding:8px 13px;border-radius:9px;font-size:12px}.filter.active,.filter:hover{background:#12375c;border-color:#328fd7;color:#eaf7ff}
.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}.card{border:1px solid #1b304c;border-radius:16px;background:linear-gradient(160deg,#102039,#0b1524 72%);overflow:hidden;transition:.2s;min-width:0}.card:hover{transform:translateY(-4px);border-color:#3479b7;box-shadow:0 16px 35px #0005}.cover{height:185px;position:relative;display:grid;place-items:center;overflow:hidden;background:radial-gradient(ellipse at 50% 70%,#1d6091aa,transparent 56%),linear-gradient(145deg,#183655,#0b1524)}.cover:before{content:"";position:absolute;width:175px;height:175px;border:1px solid #65baff33;border-radius:50%;box-shadow:0 0 0 22px #65baff0a,0 0 0 45px #65baff08}.modelicon{font-size:82px;filter:drop-shadow(0 9px 18px #3aabff66);z-index:1}.cover small{position:absolute;left:14px;top:13px;border:1px solid #4779a1aa;background:#071321b8;color:#c5e8ff;padding:5px 8px;border-radius:6px;font-size:9px;letter-spacing:.12em;text-transform:uppercase}.cover .fav{position:absolute;right:13px;top:12px;border:1px solid #4779a188;background:#081522bb;color:white;border-radius:8px;width:32px;height:32px;font-size:16px}.cardbody{padding:17px}.category{color:#70c8ff;font-size:10px;font-weight:800;letter-spacing:.16em;text-transform:uppercase}.card h3{margin:5px 0 7px;font-size:17px;letter-spacing:-.02em}.desc{margin:0;color:#9eb0c7;font-size:12px;min-height:38px}.pills{display:flex;gap:6px;flex-wrap:wrap;margin:13px 0}.pill{font-size:10px;border-radius:6px;padding:4px 7px;background:#162c45;color:#bdd8f1}.pill.good{background:#12382f;color:#9be9c7}.pill.no{background:#3a2a19;color:#f5d091}.details{display:flex;justify-content:space-between;gap:10px;border-top:1px solid #1b304c;padding-top:12px;color:#91a6c1;font-size:11px}.price{color:#f3f8ff;font-weight:800;font-size:14px}.cardactions{display:flex;gap:8px;margin-top:13px}.cardactions a,.cardactions button{flex:1;text-align:center;text-decoration:none;padding:9px 10px;border-radius:8px;font-size:11px;font-weight:750}.download{background:#2c9bed;color:#041321}.more{border:1px solid #2a4565;color:#c9e2fb;background:transparent}
.empty{display:none;padding:35px;text-align:center;color:var(--muted);border:1px dashed #29415e;border-radius:14px}
.bottomnote{margin:28px 0 65px;border:1px solid #263d5a;background:#0c1929;border-radius:13px;padding:16px 18px;color:#a6bad2;font-size:12px}.bottomnote strong{color:#dcecff}
footer{border-top:1px solid #172942;color:#7187a2;font-size:11px;padding:22px 0 30px}
dialog{background:#0c1929;color:var(--white);border:1px solid #315477;border-radius:17px;width:min(520px,calc(100% - 28px));padding:24px;box-shadow:0 25px 90px #000b}dialog::backdrop{background:#020711cc;backdrop-filter:blur(5px)}dialog h2{margin:0 0 8px}dialog p{color:#a7bad1;font-size:13px}dialog .close{float:right;background:transparent;color:#a9bfd9;border:1px solid #294563;border-radius:8px;padding:5px 9px}
@media(max-width:850px){.hero{grid-template-columns:1fr;padding-top:42px}.hero-art{height:220px}.grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:570px){.wrap{padding:0 16px}.top{padding:0 16px}.status{display:none}.hero{gap:20px}.hero-art{height:175px}.dragon{font-size:85px}.stats{gap:7px}.stat{padding:11px}.stat strong{font-size:18px}.stat span{font-size:9px}.grid{grid-template-columns:1fr}.cover{height:175px}.sectionhead{align-items:start;flex-direction:column}}
</style></head>
<body>
<nav class="top"><div class="brand"><div class="brandmark"><svg viewBox="0 0 24 24" fill="none" stroke="#041321" stroke-width="2.2"><path d="M4 16 8 5l4 5 4-5 4 11-8 4-8-4Z"/><path d="m8 5 4 5 4-5"/></svg></div>ATELIER <span style="color:#49baff">3D</span></div><div class="topright"><span class="status">● Catalogue en ligne</span><button class="admin" onclick="document.getElementById('adminInfo').showModal()">ESPACE ADMIN ↗</button></div></nav>
<main class="wrap">
<section class="hero"><div><div class="kicker">Bibliothèque de modèles · K2 SE</div><h1>Des idées qui<br><span>prennent forme.</span></h1><p>Ton espace de découverte pour les impressions 3D : dragons, figurines, objets utiles et créations originales. Trouve un modèle, vérifie sa licence et prépare ton prochain print.</p><div class="hero-actions"><a class="primary" href="#catalogue">EXPLORER LES MODÈLES ↓</a><a class="secondary" href="https://www.printables.com/" target="_blank" rel="noopener">PARCOURIR PRINTABLES ↗</a></div></div><div class="hero-art"><div class="dragon">🐉</div><div class="artlabel">IMAGINER · IMPRIMER · CRÉER</div></div></section>
<div class="stats"><div class="stat"><strong>04</strong><span>Catégories</span></div><div class="stat"><strong>K2 SE</strong><span>Imprimante cible</span></div><div class="stat"><strong>STL / 3MF</strong><span>Formats recherchés</span></div></div>
<section id="catalogue"><div class="sectionhead"><div><div class="kicker">La collection</div><h2>Modèles à découvrir</h2><p>Une première sélection de dragons, avec les licences clairement indiquées.</p></div></div>
<div class="tools"><input class="search" id="search" placeholder="⌕  Rechercher un modèle, un style…" aria-label="Rechercher"><select class="sort" id="sort"><option value="popular">Trier : sélection</option><option value="name">Nom A–Z</option></select></div>
<div class="filters"><button class="filter active" data-filter="Tous">Tout</button><button class="filter" data-filter="Dragons">Dragons</button><button class="filter" data-filter="Figurines">Figurines</button><button class="filter" data-filter="Anti-stress">Anti-stress</button><button class="filter" data-filter="Objets personnalisés">Objets personnalisés</button></div>
<div class="grid" id="grid">
<article class="card" data-category="Dragons" data-name="cute articulated dragon austin hansen">
<div class="cover"><small>Licence commerciale autorisée</small><button class="fav" aria-label="Ajouter aux favoris" onclick="favorite(this)">♡</button><div class="modelicon">🐉</div></div>
<div class="cardbody"><div class="category">DRAGONS · ARTICULÉ</div><h3>Cute Articulated Dragon</h3><p class="desc">Petit dragon cartoon articulé, imprimé en place, sans assemblage. Bon candidat pour débuter.</p><div class="pills"><span class="pill good">Domaine public</span><span class="pill">STL</span><span class="pill">Print-in-place</span></div><div class="details"><span>Austin Hansen · Printables</span><span class="price">7–10 €*</span></div><div class="cardactions"><a class="download" href="https://www.printables.com/model/1592407-cute-articulated-dragon-public-domain-free-use" target="_blank" rel="noopener">VOIR LE MODÈLE ↗</a><button class="more" onclick="details('Cute Articulated Dragon','Petit dragon articulé, conçu pour une impression facile. La fiche du créateur indique une licence domaine public, qui autorise l’usage commercial. Vérifie la page d’origine avant la mise en vente.','STL · Print-in-place · Domaine public','https://www.printables.com/model/1592407-cute-articulated-dragon-public-domain-free-use')">DÉTAILS</button></div></div></article>
<article class="card" data-category="Dragons" data-name="articulated demon dragon p1lotz">
<div class="cover"><small>Licence non commerciale</small><button class="fav" aria-label="Ajouter aux favoris" onclick="favorite(this)">♡</button><div class="modelicon">🐲</div></div>
<div class="cardbody"><div class="category">DRAGONS · FANTASTIQUE</div><h3>Articulated Demon Dragon</h3><p class="desc">Dragon détaillé, corps, tête, pattes et queue articulés. Impression en une pièce, sans supports.</p><div class="pills"><span class="pill no">Pas de vente</span><span class="pill">STL</span><span class="pill">Sans supports</span></div><div class="details"><span>P1lotz · Printables</span><span class="price">Personnel</span></div><div class="cardactions"><a class="download" href="https://www.printables.com/model/877693-articulated-demon-dragon" target="_blank" rel="noopener">VOIR LE MODÈLE ↗</a><button class="more" onclick="details('Articulated Demon Dragon','Dragon articulé très détaillé. La licence CC BY-NC-ND interdit l’usage commercial et les versions modifiées. Le créateur propose une licence commerciale séparée.','STL · CC BY-NC-ND · Non commercial','https://www.printables.com/model/877693-articulated-demon-dragon')">DÉTAILS</button></div></div></article>
<article class="card" data-category="Dragons" data-name="cute articulated dragon tomczukcustoms">
<div class="cover"><small>Licence à vérifier</small><button class="fav" aria-label="Ajouter aux favoris" onclick="favorite(this)">♡</button><div class="modelicon">🐉</div></div>
<div class="cardbody"><div class="category">DRAGONS · MULTICOLORE</div><h3>Articulated Cute Dragon</h3><p class="desc">Dragon mignon avec versions une couleur et multicolore. Plusieurs parties du corps peuvent bouger.</p><div class="pills"><span class="pill no">Vente non confirmée</span><span class="pill">STL / profils</span></div><div class="details"><span>TomczukCustoms · Printables</span><span class="price">À définir</span></div><div class="cardactions"><a class="download" href="https://www.printables.com/model/966179-articulated-cute-dragon" target="_blank" rel="noopener">VOIR LE MODÈLE ↗</a><button class="more" onclick="details('Articulated Cute Dragon','Dragon articulé avec fichiers une couleur et multicolores. La fiche indique une licence Attribution–Noncommercial–Share Alike : ne pas vendre les impressions sans autorisation écrite du créateur.','Fichiers de la fiche · CC BY-NC-SA','https://www.printables.com/model/966179-articulated-cute-dragon')">DÉTAILS</button></div></div></article>
</div><div class="empty" id="empty">Aucun modèle trouvé dans cette catégorie.</div>
</section>
<div class="bottomnote"><strong>À savoir sur les licences :</strong> un fichier gratuit n'autorise pas automatiquement la vente de l'objet imprimé. Les modèles marqués « personnel » sont réservés à tes propres impressions. Les prix affichés sont des idées de prix de vente, pas des tarifs calculés à partir du poids et du temps d'impression.</div>
<footer>ATELIER 3D · Catalogue personnel · Les modèles restent hébergés sur les plateformes de leurs créateurs.</footer>
</main>
<dialog id="detail"><button class="close" onclick="document.getElementById('detail').close()">FERMER ✕</button><div class="kicker">Fiche modèle</div><h2 id="dtitle"></h2><p id="ddesc"></p><div class="pills" id="dmeta"></div><a id="dlink" class="primary" target="_blank" rel="noopener">OUVRIR LA FICHE DU CRÉATEUR ↗</a></dialog>
<dialog id="adminInfo"><button class="close" onclick="this.closest('dialog').close()">FERMER ✕</button><div class="kicker">Zone de gestion</div><h2>Espace administrateur</h2><p>Cette première version est publiée comme catalogue public. Le bouton admin est une maquette visuelle : il n'y a pas encore de compte protégé ni de stockage privé. Pour créer un vrai espace sécurisé avec identifiant, mot de passe et fichiers privés, il faudra connecter un service d'authentification et une base de données. Ne mets aucun mot de passe dans ce fichier GitHub public.</p></dialog>
<script>
let current='Tous';
const cards=[...document.querySelectorAll('.card')];
function render(){const q=document.getElementById('search').value.toLocaleLowerCase('fr');let n=0;cards.forEach(c=>{const show=(current==='Tous'||c.dataset.category===current)&&c.dataset.name.includes(q);c.style.display=show?'block':'none';if(show)n++});document.getElementById('empty').style.display=n?'none':'block'}
document.querySelectorAll('[data-filter]').forEach(b=>b.addEventListener('click',()=>{current=b.dataset.filter;document.querySelectorAll('[data-filter]').forEach(x=>x.classList.toggle('active',x===b));render()}));
document.getElementById('search').addEventListener('input',render);
document.getElementById('sort').addEventListener('change',e=>{const grid=document.getElementById('grid');[...cards].sort((a,b)=>e.target.value==='name'?a.dataset.name.localeCompare(b.dataset.name,'fr'):cards.indexOf(a)-cards.indexOf(b)).forEach(c=>grid.appendChild(c))});
function favorite(b){b.textContent=b.textContent==='♡'?'♥':'♡';b.style.color=b.textContent==='♥'?'#ff8fa8':'white'}
function details(title,desc,meta,url){document.getElementById('dtitle').textContent=title;document.getElementById('ddesc').textContent=desc;document.getElementById('dmeta').textContent=meta;document.getElementById('dlink').href=url;document.getElementById('detail').showModal()}
</script>
</body></html>
